DATABASE_URL="sqlserver://YOUR_SERVER;database=new_leads_pms;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true;encrypt=true"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep the SAME key as the existing installation, or saved passwords cannot be decrypted.
ENCRYPTION_KEY=
SESSION_COOKIE_SECURE=false
# PORT=3000

# Public address of the site, used in password reset links (recommended in production).
# APP_URL=https://credentials.example.com

# Optional: email password reset links. Without SMTP, administrators can still create a
# one-time reset link from User Management and pass it on themselves.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=
# SMTP_FROM="Leads Credential Manager <no-reply@example.com>"

# Optional: AI features (assistant, smart search, health check, insights, entry assistant).
# Any OpenAI-compatible Responses API. Without a key the rest of the app works normally.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5-mini
# Or, instead of AI_API_KEY, a Lovable AI gateway key:
# LOVABLE_API_KEY=
